# Copy to config.env and fill locally. Do not commit config.env.

# Required, both free -- fill these two in.
COLLEGE_FOOTBALL_DATA_API_KEY=
ODDS_API_KEY=

# Not needed. Weather comes from the free/keyless api.weather.gov (no key
# exists for that). SportsDataIO and Sportradar are paid commercial feeds,
# deliberately deferred -- see 03-projects/football-picks-agent/decisions.md.
# Leave these blank; only fill in if you decide to pay for one later.
SPORTSDATAIO_API_KEY=
SPORTRADAR_API_KEY=

# Comma-separated sportsbook keys once selected.
BOOKMAKERS=

# Weekly board markets. Three markets cost three Odds API credits per
# league-specific pull with the current one-region bookmaker configuration.
ODDS_API_MARKETS=h2h,spreads,totals

# Conservative defaults for MVP.
MIN_SPREAD_EDGE_POINTS=1.5
MIN_TOTAL_EDGE_POINTS=1.5
MIN_MONEYLINE_EDGE_PROB=0.03

# Live weekly-board settings. Full-game Over and Under markets are eligible
# for NCAA and NFL cards. They compete in the same confidence sort with no
# reserved slots or forced market variety.
TOTALS_ELIGIBLE=1
MAX_DOG_SPREAD_POINTS=14
MIN_ML_DISAGREE_PCT=2.0

# Price check on the Tuesday card (AQ-222): tolerated move against a listed pick.
CHECK_MAX_POINT_LOSS=1.0
CHECK_MAX_PRICE_LOSS_CENTS=10

# Ranking v3 (AQ-220/221): the board ranks by DraftKings edge vs consensus in
# cents. From backtest-signals 2026-09-18: >=1.5c beat the close 69% (n=230),
# >=2.0c 73% (n=175). Under the floor a row prints but carries no units.
EDGE_FLOOR_CENTS=1.5
EDGE_TWO_UNIT_CENTS=2.0
MIN_CONSENSUS_BOOKS=2

# edge.py (AQ-271, 2026-10-02): the one-question engine. DraftKings vs Pinnacle only.
EDGE_MIN_SPREAD_POINTS=1.0
EDGE_SAME_POINT_CENTS=20
EDGE_MIN_ML_EV_PCT=2.5
EDGE_ML_CEILING=-250
EDGE_PAPER_FLAGS=100
EDGE_PAPER_GATE_PCT=54
EDGE_ML_DOG_CEILING=250
EDGE_MAX_PRICE_GIVEBACK_CENTS=10

# Daily card (2026-10-07, David: "3 picks a day: ML, over/under, scorer or any
# of the best props for each NFL, NCAA and NHL"). football.py daily ranks
# win-first across the leagues playing that day, one pick per game.
DAILY_PICKS=3
# Player props: The Odds API event endpoint, one credit per market per event.
# Budget per run, and a floor the account never drops under (protects the
# rationed game-line pulls). Markets per league; props carry at most 1 unit.
PROPS_DAILY_CREDIT_BUDGET=6
PROPS_MIN_CREDITS_RESERVE=60
PROPS_MARKETS_NFL=player_anytime_td
PROPS_MARKETS_NCAAF=player_anytime_td
PROPS_MARKETS_NHL=player_goal_scorer_anytime,player_shots_on_goal,player_points
PROPS_MAX_UNITS=1
PROPS_MAX_ODDS=350
# Markets on the daily card: moneyline, over/under, player props ("player"). Spreads and puck lines stay on `board`.
DAILY_MARKETS=h2h,totals,player
# Card shape: "slots" = per league the likeliest ML, the likelier side of a total, the likeliest prop (DAILY_PICKS slots);
# "top" = the best DAILY_PICKS rows across all leagues, any market. David picks; the code does not.
DAILY_SHAPE=slots
# Card order when several leagues play (David 2026-10-13: hockey first).
DAILY_LEAGUE_ORDER=NHL,NFL,CFB
# Parlay gate (David 2026-10-13: "Force me to make smart bets"). football.py parlay
# refuses to print or log a ticket that breaks any of these.
PARLAY_MAX_LEGS=3
PARLAY_MIN_LEG_WIN=56
PARLAY_MIN_HIT_PCT=18
PARLAY_MAX_UNITS=0.5
PARLAY_MAX_PER_DAY=1
# The one fun ticket per slate (David 2026-10-13: "profit over quick profit ...
# maybe 1 fun lotto per slate that is juicy"). Small stake, still gated.
LOTTO_MAX_LEGS=5
LOTTO_MIN_LEG_WIN=40
LOTTO_MIN_HIT_PCT=3
LOTTO_MAX_UNITS=0.25
LOTTO_MAX_PER_DAY=1
