<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.davidos.football-free-lines</string>
    <key>WorkingDirectory</key>
    <string>/PATH/TO/REPO</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>cd /PATH/TO/REPO/04-agents/football-picks-agent &amp;&amp; /usr/bin/python3 -B fetch-free-lines.py; /usr/bin/python3 -B edge.py flag</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/YOU</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>DAVIDOS_CONFIG</key>
        <string>/Users/YOU/.config/davidos</string>
    </dict>
    <!-- every 30 minutes; the script exits in ~2s and touches two keyless endpoints per league -->
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/YOU/Library/Logs/davidos/football-free-lines.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/Library/Logs/davidos/football-free-lines.err</string>
</dict>
</plist>
